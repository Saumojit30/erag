# ==============================================================================
# Git Ignore Configuration for E-RAG Academic Research Repository
# ==============================================================================

# 1. Environment Variables, Secrets & API Keys (Strict Security)
.env
*.env
.env.*
!.env.example
*.pem
*.key
*.cert
credentials.json

# 2. Virtual Environments & Local Runtimes
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
lib/
include/

# 3. Python Bytecode, Caches & Distribution
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
MANIFEST

# 4. Testing, Coverage & Type-Checking Artifacts
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/

# 5. ML Models, Checkpoints, Large Embeddings & Heavy Weights
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.parquet
*.feather
*.arrow
*.faiss
*.index

# 6. Experiment Tracking, Local DBs & Memoization Stores
mlruns/
mlflow.db
wandb/
lightning_logs/
*.sqlite
*.sqlite3
*.db
*.db-journal

# 7. Raw Datasets & Corpus Dumps (External / Large)
data/raw/
data/cache/

# 8. Experimental Outputs & Prediction Tracking
# LLM caches and the NLI memo are derived data, not source: the shared
# cache.sqlite is untracked (2026-11-13), and each experiment writes its
# own cache file under results/cache/ (see run.cache_path). Result JSONLs
# stay tracked as experiment evidence.
results/cache.sqlite
results/nli_memo.pkl
results/cache/

# 9. Logs, Temp Files & Editor Backups
*.log
*.tmp
*.bak
*.swp
*.swo
*~
*.lock

# 10. IDE & OS Artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# 11. Scratch Workspaces & Agent Artifacts
scratch/
.gemini/

# Adaptive-RAG raw downloads (regenerable, ~370MB; do not commit)
data/raw_downloads/
